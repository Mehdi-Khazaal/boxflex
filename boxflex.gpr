library project Boxflex is

   for Library_Name use "boxflex";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",   --  Ada 2022
         "-gnata",      --  contracts and assertions checked at runtime
         "-gnatwa",     --  all warnings
         "-gnatwe",     --  warnings are errors
         "-gnatVa",     --  all validity checks
         "-gnatyg",     --  GNAT style checks
         "-gnatyM100",  --  ... but 100 columns
         "-g", "-O1",
         "-fstack-check");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "-j0");
   end Prove;

end Boxflex;
